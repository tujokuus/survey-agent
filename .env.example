# Copy this file to .env and adjust values if needed.
SURVEY_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SURVEY_AGENT_OLLAMA_MODEL=qwen3.5:9b
SURVEY_AGENT_DATABASE_PATH=data/survey_browser_agent.db

# Dedicated system Chrome profile. Its display name is resolved through Chrome's Local State.
SURVEY_AGENT_CHROME_PROFILE_NAME=Giveaway Agent

# Leave empty to let Browser Use find Google Chrome.
SURVEY_AGENT_CHROME_EXECUTABLE_PATH=

# Safety and reliability limits.
SURVEY_AGENT_MAX_STEPS=12
SURVEY_AGENT_TIMEOUT_SECONDS=600
# This override applies only when SURVEY_AGENT_OLLAMA_MODEL=qwen3.5:9b.
SURVEY_AGENT_QWEN35_9B_LLM_TIMEOUT_SECONDS=180
# This override applies only when SURVEY_AGENT_OLLAMA_MODEL=llama3.1:8b.
SURVEY_AGENT_LLAMA31_8B_LLM_TIMEOUT_SECONDS=180
# Keep the local model prompt and response bounded for the read-only MVP.
SURVEY_AGENT_OLLAMA_CONTEXT_TOKENS=16384
SURVEY_AGENT_OLLAMA_MAX_OUTPUT_TOKENS=2048
SURVEY_AGENT_USE_VISION=false

# Browser Use stays local for this learning project.
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
